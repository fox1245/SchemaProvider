#pragma once
// Generated by CMake from cmake/build_config.h.in. Do not edit.
//
// SP_BUILD_THREADS is 1 when this SchemaProvider was configured with SP_THREADS=ON (OS threads: the default
// worker pool and the libcurl transport) and 0 for a single-thread build.
#define SP_BUILD_THREADS @SP_BUILD_THREADS@

// Sentinel. Asio is header-only: its classes and inline code differ between ASIO_DISABLE_THREADS and a threaded
// build, so two translation units of one program that disagree violate the one-definition rule and nothing
// diagnoses it. Every SchemaProvider header reaches this one (through core/value.h), and a translation unit whose
// thread setting differs from the one recorded here stops compiling. The SchemaProvider CMake targets export
// ASIO_DISABLE_THREADS in a single-thread build, so a CMake consumer agrees by construction; a consumer that builds
// its own flags has to agree explicitly.
#if SP_BUILD_THREADS
#  if defined(ASIO_DISABLE_THREADS)
#    error "SchemaProvider was built with threads (SP_THREADS=ON) but this translation unit defines ASIO_DISABLE_THREADS: build both the same way"
#  endif
#  if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
#    error "SchemaProvider was built with threads (SP_THREADS=ON) but this translation unit is compiled without -pthread: build both the same way"
#  endif
#else
#  if !defined(ASIO_DISABLE_THREADS)
#    error "SchemaProvider was built without threads (SP_THREADS=OFF): define ASIO_DISABLE_THREADS in this translation unit (the SchemaProvider CMake targets export it)"
#  endif
#  if defined(__EMSCRIPTEN_PTHREADS__)
#    error "SchemaProvider was built without threads (SP_THREADS=OFF) but this translation unit is compiled with -pthread: build both the same way"
#  endif
#endif
