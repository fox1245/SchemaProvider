  "configuration_inventory": {
    "workload_version": 2,
    "closed_fields": true,
    "zero_semantics": "Zero server delay and warmup are permitted; zero max_host_connections keeps libcurl's default; runtime codec_iterations may be zero. Missing fields are rejected, not replaced by zero or defaults.",
    "benchmark_control_bounds": ["peer_timeout_ms", "peer_reply_bytes", "sample_interval_ms", "model_input_limit", "model_output_limit"],
    "external_safety_policies": ["config/descriptor-policy.json", "config/codec-defaults.json", "config/runtime-defaults.json"],
    "intentional_code_semantics": ["newline-delimited peer control framing", "4096-byte control read buffer", "retry disabled with max_attempts=1", "protocol enum indexes", "synthetic fixture token counts and carrier identity"],
    "native_chat_origin": "Only native Chat admits the peer's exact ephemeral loopback HTTPS origin in its benchmark-owned descriptor policy; existing family facts, global configuration and system trust are unchanged."
  },
  "scope": "Controlled independent TLS oracle, no model inference. Paired configurations preserve original workload knobs; extensions are separate measurements. Native carrier is public synthetic data, not vendor-valid cryptography."
