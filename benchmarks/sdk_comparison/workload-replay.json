{
  "version": 1,
  "model": "bench-model",
  "system": "You are a benchmark assistant.",
  "user_prefix": "benchmark-request:",
  "user_payload_bytes": 128,
  "max_tokens": 256,
  "response_prefix": "benchmark-ok:",
  "response_payload_bytes": 1200,
  "stream_chunks": 50,
  "api_key": "bench-not-a-real-key",
  "apis": {
    "openai": {
      "family": "openai.chat",
      "path_prefix": "/openai/chat/text"
    },
    "anthropic": {
      "family": "anthropic.messages",
      "path_prefix": "/anthropic/messages/text"
    }
  },
  "concurrency_levels": [
    1,
    16,
    128
  ],
  "min_measured_requests": 24,
  "measured_requests_per_slot": 4,
  "min_warmup_requests": 4,
  "warmup_requests_per_slot": 1,
  "note": "Replay workload: the request is the same as workload.json; every reply is a recorded provider response sent at its recorded pace (replay/README.md), so a request takes seconds and the counts are smaller. response_prefix, response_payload_bytes and stream_chunks are unused in replay."
}
