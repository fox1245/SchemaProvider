{
  "version": 2,
  "family": "openai.responses",
  "case": "native",
  "mode": "runtime",
  "streaming": false,
  "warmup_requests": 10,
  "measured_requests": 100,
  "concurrency": 32,
  "process_repetitions": 3,
  "payload_bytes": 256,
  "server_delay_ms": 5,
  "workers": 1,
  "io_threads": 1,
  "resolver_threads": 1,
  "max_host_connections": 32,
  "max_operations": 64,
  "output_tokens": 64,
  "timeout_ms": 30000,
  "http_preference": "h2",
  "retry_enabled": false,
  "max_attempts": 1,
  "retain_results": true,
  "codec_iterations": 0,
  "node": "node",
  "peer_script": "tools/benchmark_peer.mjs",
  "source_revision": "working-tree-provider-native-policy-cutover",
  "descriptor_policy": "config/descriptor-policy.json",
  "codec_policy": "config/codec-defaults.json",
  "model_input_limit": 1048576,
  "model_output_limit": 128,
  "peer_timeout_ms": 30000,
  "peer_reply_bytes": 16777216,
  "sample_interval_ms": 1
}
