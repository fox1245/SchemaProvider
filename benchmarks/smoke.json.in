{
  "version": 2,
  "family": "@family@",
  "case": "@case@",
  "mode": "@mode@",
  "streaming": false,
  "warmup_requests": 0,
  "measured_requests": 2,
  "concurrency": 1,
  "process_repetitions": 1,
  "payload_bytes": 64,
  "server_delay_ms": 0,
  "workers": 1,
  "io_threads": 1,
  "resolver_threads": 1,
  "max_host_connections": 4,
  "max_operations": 4,
  "output_tokens": 16,
  "timeout_ms": 30000,
  "http_preference": "h1",
  "retry_enabled": false,
  "max_attempts": 1,
  "retain_results": true,
  "codec_iterations": @iterations@,
  "node": "@SP_NODE@",
  "peer_script": "tools/benchmark_peer.mjs",
  "source_revision": "smoke",
  "descriptor_policy": "config/descriptor-policy.json",
  "codec_policy": "config/codec-defaults.json",
  "model_input_limit": 1048576,
  "model_output_limit": 128,
  "peer_timeout_ms": 30000,
  "peer_reply_bytes": 16777216,
  "sample_interval_ms": 1
}
